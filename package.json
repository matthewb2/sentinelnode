{
  "name": "sentinelnode",
  "version": "1.0.0",
  "description": "Local AI-powered DAST security scanner",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env ELECTRON_DEV=1 tsc && cross-env ELECTRON_DEV=1 electron .",
    "build": "tsc && vite build",
    "build:ui": "npx tailwindcss -i ./src/ui/index.css -o ./dist/output.css --watch",
    "build:ts": "tsc",
    "start": "tsc && vite build && electron ."
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "axios": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
